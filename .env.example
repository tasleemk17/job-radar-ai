# Copy to .env next to docker-compose.yml. Never commit .env.

# Signs login tokens. Use a long random string:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional. Without it everything works, but analysis and cover letters are rule-based.
# ANTHROPIC_API_KEY=
# A small model is cheap and fast enough for these short answers.
# ANTHROPIC_MODEL=claude-haiku-5-5

# More job sources (optional). Remotive and Arbeitnow always work without a key.
# Adzuna, free keys at https://developer.adzuna.com. Country "in" is India.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in
# Jooble, free key at https://jooble.org/api/about
# JOOBLE_API_KEY=
# City used when your profile has no preferred location (leave India for the whole country)
# JOB_LOCATION=India

# How often new jobs are fetched, in hours
# REFRESH_HOURS=6
