# For running the backend directly (uvicorn). Copy to backend/.env, which is never committed.
# The same names work in the project-level .env used by Docker Compose.

# ANTHROPIC_API_KEY=

# Adzuna, free keys at https://developer.adzuna.com. Country "in" is India.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in

# Jooble, free key at https://jooble.org/api/about
# JOOBLE_API_KEY=

# JOB_LOCATION=India
